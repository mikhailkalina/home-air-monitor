# SPDX-License-Identifier: Apache-2.0
#
# Formatting for C11 (ports/, core/, drivers/, platform/) and the C++17
# simulator GUI. Enforced by the format job in .github/workflows/checks.yml:
#
#   clang-format -i <file>        # fix
#   clang-format --dry-run --Werror <file>   # what CI runs
#
# CI runs whatever clang-format its runner image ships: 18.1.3 on
# ubuntu-24.04, which ubuntu-latest resolves to as of 2026-10. Versions
# disagree on a few constructs -- a braced initializer as a macro body passed
# 21.1.8 locally and failed 18.1.3 in CI (phase 2d), and no layout satisfied
# both. Check with CI's version before pushing:
#
#   pip install clang-format==18.1.3    # into a venv
---
BasedOnStyle: LLVM

IndentWidth: 4
ColumnLimit: 100
UseTab: Never

# Brace on its own line for a function definition, attached everywhere else.
BreakBeforeBraces: Linux

# Braces are mandatory, so nothing collapses onto one line.
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false

# const char *name, not const char* name.
PointerAlignment: Right
DerivePointerAlignment: false

IndentCaseLabels: true
SpacesBeforeTrailingComments: 2
AlignTrailingComments: true

# Keep macro line continuations next to the code instead of pushed out to the
# column limit.
AlignEscapedNewlines: Left

# Keep the "own header, then system, then project" grouping that the sources
# use; sort only within each group.
IncludeBlocks: Preserve
SortIncludes: true
