# SPDX-License-Identifier: Apache-2.0
#
# Wi-Fi and MQTT credentials for the firmware and the on-target test app
# (phase 4e, docs/adr/0032-wifi-on-the-board.md; phase 4g,
# docs/adr/0033-mqtt-on-the-board.md). Copy this file to
# sdkconfig.credentials beside it -- gitignored, never committed -- and fill
# in the lines:
#
#   cp sdkconfig.credentials.example sdkconfig.credentials
#
# Every build of the firmware (its BSEC and calibration variants included)
# and of the test app layers it last over its defaults, so it survives a
# deleted sdkconfig. Like every overlay it reaches only an sdkconfig that does
# not hold the symbols yet; after changing it, delete the build's sdkconfig
# and reconfigure, then check that the name arrived (the build refuses to go
# on while the overlay and the sdkconfig disagree):
#
#   rm -f sdkconfig build-bsec/sdkconfig test_app/sdkconfig test_app/build-bsec/sdkconfig
#   idf.py reconfigure build
#   grep CONFIG_HAC_WIFI_SSID sdkconfig
#   grep CONFIG_HAC_MQTT_BROKER_URI sdkconfig
#
# Empty, as here, means no network: the firmware runs without Wi-Fi. A network
# without a broker means Wi-Fi and SNTP without MQTT.
#
# An image built with credentials holds them in plain text. Never attach one
# -- nor an sdkconfig, nor this file filled in -- to an issue or a pull
# request.

# The network's name, 1 to 32 octets.
CONFIG_HAC_WIFI_SSID=""

# Its WPA2/WPA3 password, 8 to 64 characters; empty for an open network.
CONFIG_HAC_WIFI_PASSWORD=""

# The MQTT broker, mqtt://<host>[:<port>] -- plain MQTT on the LAN, no TLS:
# an address, or a name the router resolves (not .local). Empty: no MQTT.
CONFIG_HAC_MQTT_BROKER_URI=""

# The user the board logs in as, and its password; both empty for an
# anonymous broker. The password crosses the LAN in clear text (ADR 0033).
CONFIG_HAC_MQTT_USER=""
CONFIG_HAC_MQTT_PASSWORD=""

# The topics' first levels: <prefix>/hac-<MAC>/state. Optional: without this
# line the image's default, "homeair", the simulator's too.
# CONFIG_HAC_MQTT_TOPIC_PREFIX="homeair"
