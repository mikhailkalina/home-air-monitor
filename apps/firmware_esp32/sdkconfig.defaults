# SPDX-License-Identifier: Apache-2.0
#
# Defaults only. sdkconfig itself is gitignored: after menuconfig it holds the
# Wi-Fi SSID, the password and the broker address.

CONFIG_IDF_TARGET="esp32s3"

# The 960x540 4bpp framebuffer is 253 KB and lives in PSRAM (phase 2).
# N16R8: 16 MB flash, 8 MB octal PSRAM (docs/hardware/board_notes.md).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Lets heap_caps_malloc(..., MALLOC_CAP_SPIRAM) (adp_display_null.c) draw from
# PSRAM through the normal heap allocator rather than requiring a capability
# only esp_himem or a raw PSRAM API could grant.
CONFIG_SPIRAM_USE_MALLOC=y

# apps/firmware_esp32/partitions.csv: two OTA app slots on the 16 MB module,
# sized for phase 5's OTA work; no factory slot.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Firmware from the card (docs/adr/0037-firmware-from-the-card.md): an image
# installed into the other OTA slot boots once as "pending verify" and
# confirms itself at its first frame; the bootloader rolls back one that
# resets before that. A bootloader setting -- it reaches the board only with
# a new bootloader.bin, which the usual esptool command flashes at 0x0 -- and
# the app's: main/fw_update.c refuses an sdkconfig without it.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# This board's USB-C is the S3's native USB-Serial-JTAG (README.MD FAQ 4), not
# a separate UART bridge chip. If idf.py monitor shows nothing, the one-line
# fallback is CONFIG_ESP_CONSOLE_UART_DEFAULT=y in place of this.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Raises the COMPILE-TIME ceiling to DEBUG so ESP_LOGD calls are not
# stripped from the binary; CONFIG_LOG_DEFAULT_LEVEL_INFO above is the
# RUNTIME default and is unaffected -- the boot log stays at INFO unless a
# specific tag is raised in code (see main.c's esp_log_level_set() call).
# Costs a small amount of extra binary size for every already-written
# ESP_LOGD call in the tree (this project's and ESP-IDF's own), even where
# nothing raises that tag at runtime.
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# EPDiy's ESP32-S3 row-by-row render method, required by this board: its
# default S3 method needs LEH and STV on real GPIOs, which this board routes
# through a 74HCT4094 shift register instead. See
# docs/adr/0007-epaper-backend.md and the dependency pin in
# components/hac_platform/idf_component.yml.
CONFIG_EPD_ESP32S3_I80_ROW_OUTPUT=y

# The microSD card's files have long names ("2026-10-16_bme68x_2.csv",
# docs/adr/0024): FATFS's long file names, their buffer on the heap rather
# than on the calling task's stack. platform/esp32_t5s3/adp_sd.c refuses to
# build without them -- a default added here does not reach an sdkconfig
# that already exists (CLAUDE.md).
CONFIG_FATFS_LFN_HEAP=y

# Wi-Fi (phase 4e, docs/adr/0032-wifi-on-the-board.md). lwIP's task on the
# protocol core, beside ESP-IDF's Wi-Fi task (core 0 by default): core 1 runs
# the event loop and EPDiy's row output, and keeps them to itself.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
# The Wi-Fi driver's and lwIP's buffers stay in internal RAM, as ESP-IDF's
# default has them: the octal PSRAM is the part that did not ride out dips on
# VDD3V3 (phase 3f), and a transmit burst is where the radio draws most. The
# ADR has the reasoning and the budget it leaves.
# CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP is not set
# A station only: no access point of its own, which saves its code and its
# buffers. Phase 6's provisioning, if it chooses SoftAP, turns this back on.
# CONFIG_ESP_WIFI_SOFTAP_SUPPORT is not set
# The Wi-Fi driver's code in flash, not IRAM: 17,564 bytes of static internal
# RAM back, by idf.py size (2026-10-21) -- with them on the board had 56.7 KB
# free with the link up, 42.7 KB at the least -- at a throughput a message a
# minute does not need.
# platform/esp32_t5s3/adp_net.c refuses to build with an sdkconfig that has
# either on.
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set

# MQTT (phase 4g, docs/adr/0033-mqtt-on-the-board.md): plain MQTT 3.1.1 on the
# LAN. esp-mqtt's TLS and websocket transports are not linked -- the broker's
# URI refuses mqtts:// -- and its task runs on the protocol core, beside
# Wi-Fi's and lwIP's, never on core 1 with the event loop and EPDiy's row
# output. platform/esp32_t5s3/adp_mqtt.c refuses to build with an sdkconfig
# that has either transport on, or the task unpinned.
# CONFIG_MQTT_TRANSPORT_SSL is not set
# CONFIG_MQTT_TRANSPORT_WEBSOCKET is not set
CONFIG_MQTT_TASK_CORE_SELECTION_ENABLED=y
CONFIG_MQTT_USE_CORE_0=y
