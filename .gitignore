# ---- Secrets: never commit -------------------------------------------------
# After menuconfig, sdkconfig holds the Wi-Fi SSID, password and broker address.
# Only sdkconfig.defaults, without credentials, belongs in the repository.
sdkconfig
sdkconfig.old
sdkconfig.ci
**/secrets.h
**/credentials.h
.env
*.pem
*.key

# ---- Third-party binaries under restrictive licenses ----------------------
# BSEC/BSEC2 is downloaded from Bosch after accepting their license agreement.
third_party/bsec/
**/libalgobsec.a

# ---- Build output ---------------------------------------------------------
build/
build-*/
out/
cmake-build-*/
_deps/
CMakeUserPresets.json
compile_commands.json

# ---- ESP-IDF --------------------------------------------------------------
managed_components/
dependencies.lock
*.bin
*.elf
*.map
size.json
# ...except golden-test reference fixtures, which are checked-in binary test
# data, not a build artifact. Each .bin ships with a .png rendered from the
# same buffer (see tests/golden/golden_check.c) so a layout regression is
# visible in review -- GitHub renders a .bin diff as "Binary file not shown".
!tests/golden/*.bin
!tests/golden/*.png

# ---- Simulator and test artifacts -----------------------------------------
frames/
*.png.actual
sim_state/
Testing/
*.profraw
*.gcda
*.gcno

# ---- Editors and OS -------------------------------------------------------
.vscode/
.idea/
.cache/
*.swp
.DS_Store
Thumbs.db
