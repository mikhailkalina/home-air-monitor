# ---- Secrets: never commit -------------------------------------------------
# After menuconfig, sdkconfig holds the Wi-Fi SSID, password and broker address.
# Only sdkconfig.defaults, without credentials, belongs in the repository.
sdkconfig
sdkconfig.old
sdkconfig.ci
**/secrets.h
**/credentials.h
.env
*.pem
*.key

# ---- Private pictures: never commit ---------------------------------------
# The photo frame's photographs (apps/photo_frame/) are family photos: they
# belong on the device, not in a public repository's permanent history.
/apps/photo_frame/images/

# ---- Third-party binaries under restrictive licenses ----------------------
# BSEC/BSEC2 is downloaded from Bosch after accepting their license agreement.
third_party/bsec/
**/libalgobsec.a

# ---- Build output ---------------------------------------------------------
build/
build-*/
out/
cmake-build-*/
_deps/
CMakeUserPresets.json
compile_commands.json

# ---- ESP-IDF --------------------------------------------------------------
# Anchored to where the component manager actually writes, not a bare
# `managed_components/`: that pattern matches a directory of that name at any
# depth, which also swallowed
# scripts/tests/fixtures/pin_literals/.../managed_components/ -- the fixture
# that proves check_sources.sh skips fetched dependencies. An ignored fixture
# makes that test pass vacuously, which is worse than not having it.
/apps/*/managed_components/
# The on-target test app is a second ESP-IDF project with its own fetch of
# the same dependencies (apps/firmware_esp32/test_app/).
/apps/*/test_app/managed_components/
# ...and so are the slideshow and the photo frame (apps/*/esp32/).
/apps/slideshow/esp32/managed_components/
/apps/photo_frame/esp32/managed_components/
dependencies.lock
*.bin
*.elf
*.map
size.json
# ...except golden-test reference fixtures, which are checked-in binary test
# data, not a build artifact. Each .bin ships with a .png rendered from the
# same buffer (see tests/golden/golden_check.c) so a layout regression is
# visible in review -- GitHub renders a .bin diff as "Binary file not shown".
!tests/golden/*.bin
!tests/golden/*.png

# ---- Simulator and test artifacts -----------------------------------------
__pycache__/
frames/
*.png.actual
sim_state/
Testing/
*.profraw
*.gcda
*.gcno

# ---- Editors and OS -------------------------------------------------------
.vscode/
.idea/
.cache/
*.swp
.DS_Store
Thumbs.db
